{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.next/**",
    "**/.tanstack/**",
    "**/.source/**",
    "**/.nx/**",
    "**/.git/**",
    "**/coverage/**",
    "**/test-output/**",
    "**/out-tsc/**",
    "**/*.d.ts",
    ".agents/**",
    ".codex/**",
    ".vezham/**",
    "**/public/{sw.js,404.html,offline.html}",
    "**/src/generated/**",
    "**/content/**/(generated)/**",
    "**/routeTree.gen.ts",
    "apps*/**/*-mock/**"
  ],
  "entry": [
    "**/src/app/**/{page,layout,error,global-error,loading,not-found}.tsx",
    "**/src/app/**/route.ts",
    "**/src/routes/**/*.{ts,tsx}",
    "**/src/router.tsx",
    "**/content/**/*.mdx",
    "packages/vx/config/src/lib/{metadata,deploy}/cli.ts",
    "packages/vx/config/src/lib/presets/docs/cli.ts",
    "vx/tools/audit/index.mjs",
    "vx/tools/release/index.ts",
    "vx/tools/release/version-actions.cjs",
    "vx/tools/eslint/tests/*.test.mjs"
  ],
  "framework": [
    {
      "name": "vx-workspace-tools",
      "enablers": ["nx"],
      "toolingDependencies": [
        "@eslint/js",
        "@nx/plugin",
        "@swc-node/register",
        "@swc/helpers",
        "eslint-config-prettier",
        "eslint-plugin-import",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "hostile",
        "jiti",
        "react-doctor",
        "sort-package-json",
        "tslib",
        "typescript-eslint",
        "verdaccio"
      ]
    }
  ],
  "ignoreDependencies": [
    "@fontsource/inter",
    "@fontsource/jura",
    "@next/eslint-plugin-next",
    "@number-flow/react",
    "@nx/devkit",
    "@nx/eslint-plugin",
    "@tailwindcss/vite",
    "@tanstack/react-devtools",
    "@tanstack/react-query",
    "@tanstack/react-query-devtools",
    "@testing-library/jest-dom",
    "@testing-library/react",
    "@tiptap/core",
    "@tiptap/extension-link",
    "@tiptap/extension-underline",
    "@tiptap/extensions",
    "@tiptap/pm",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@tiptap/suggestion",
    "@vercel/og",
    "@vezham/docs-core",
    "@vezham/docs-mdx",
    "@vezham/docs-openapi",
    "@vezham/docs-react",
    "@vezham/docs-story",
    "@vezham/icons-react",
    "@vezham/react-pro-v3",
    "@vezham/react-v2",
    "@vezham/react-v3",
    "@vezham/styles-v3",
    "@vezham/use-logger",
    "@vitejs/plugin-react-swc",
    "axios",
    "embla-carousel",
    "embla-carousel-react",
    "eslint-plugin-playwright",
    "maplibre-gl",
    "marked",
    "nitro",
    "react",
    "react-dom",
    "react-markdown",
    "recharts",
    "remark-breaks",
    "remark-gfm",
    "shiki",
    "streamdown",
    "tailwind-variants",
    "yaml",
    "yargs"
  ],
  "ignoreDependencyOverrides": [
    // vx-bot/NOTE: These transitive peer aliases resolve to the forks in pnpm-lock.yaml.
    { "package": "fumadocs-core", "source": "pnpm-workspace.yaml" },
    { "package": "fumadocs-ui", "source": "pnpm-workspace.yaml" }
  ],
  "ignoreExports": [
    {
      "file": "**/src/app/**/layout.tsx",
      "exports": ["metadata", "viewport", "generateMetadata"]
    }
  ],
  "duplicates": {
    "ignore": [
      // vx-bot/NOTE: CLI app Vite configs stay local so generated apps are self-contained.
      "apps/*/vite.config.ts",
      "apps*/**/src/pages/{home,pro}/index.tsx",
      "apps*/**/__tests__/app.test.tsx",
      "apps*/**/*-e2e/**"
    ]
  },
  "health": {
    // vx-bot/TODO: Restore coverage enforcement when CLI template tests are established.
    // Remove maxCrap: 0 and restore the coverage path below.
    // "coverage": "test-output/audit/eslint-coverage/coverage-final.json",
    "maxCrap": 0
  },
  "rules": {
    "coverage-gaps": "off"
  }
}
